<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground. Viewport is 108x108dp, safe zone is 66x66dp
    centered. The symbol is drawn inside the safe zone with a small margin
    so launchers that crop the icon (circle, squircle, teardrop) keep the
    art intact.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateX="21" android:translateY="21">
        <!-- Top wave -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M0 33 C 14 14 28 14 42 33 S 70 52 84 33" />
        <!-- Bottom wave -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M0 52 C 14 33 28 33 42 52 S 70 71 84 52" />
        <!-- Sync dot at the right end -->
        <path
            android:fillColor="#000000"
            android:pathData="M62 33 m -3.5 0 a 3.5 3.5 0 1 0 7 0 a 3.5 3.5 0 1 0 -7 0" />
    </group>
</vector>
