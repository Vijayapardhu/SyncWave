<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base app theme. Applied after the splash is dismissed. Light
        surfaces, dark ink — matches the brand (white background plate,
        black waves).
    -->
    <style name="Theme.SyncWave" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/syncwave_background</item>
        <item name="android:statusBarColor">@color/syncwave_background</item>
    </style>

    <!--
        Splash screen theme. On Android 12+ the SplashScreen API reads
        these attributes. On older devices (q- and below) we fall back
        to the windowBackground drawable.
    -->
    <style name="Theme.SyncWave.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/syncwave_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sw_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.SyncWave</item>
        <!-- Pre-12 fallback -->
        <item name="android:windowBackground">@drawable/sw_splash_background</item>
    </style>
</resources>
